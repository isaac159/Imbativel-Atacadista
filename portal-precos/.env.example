# Copie para .env.local (local) e cadastre as mesmas chaves na Vercel → Settings → Environment Variables.
# Nunca suba .env.local para o Git.

# Usuários do portal: "usuario:senha" separados por ";"
PORTAL_USUARIOS=imbativel:troque-esta-senha

# Segredo que assina o cookie de sessão (mínimo 32 caracteres). Gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SEGREDO=

# Chave que o n8n manda para ler os preços em /api/dados (mínimo 24 caracteres). Gerar do mesmo jeito.
# No n8n, nó "Dados do portal" → cabeçalho  Authorization: Bearer <esta chave>
PORTAL_CHAVE_N8N=

# Banco (Upstash Redis). Na Vercel: Storage → Upstash for Redis → Connect, e as duas chaves aparecem sozinhas.
# Em teste local, deixe vazio: os preços ficam na pasta .dados/.
KV_REST_API_URL=
KV_REST_API_TOKEN=
